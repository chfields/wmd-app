{
  "name": "wmd-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "serve": "^14.2.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --clear",
    "test:gift-message": "EXPO_PUBLIC_GIFT_MESSAGE_ENABLED=false node --experimental-transform-types --test test/gift-message.test.ts",
    "e2e": "EXPO_PUBLIC_BFF_URL=http://bff.test EXPO_PUBLIC_GIFT_MESSAGE_ENABLED=true npm run build:web && playwright test"
  },
  "private": true
}
